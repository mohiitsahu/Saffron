generator client {
  provider      = "prisma-client-js"
  // rhel target is needed for Netlify's serverless runtime
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  CHEF
  ADMIN
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  CANCELLED
  COMPLETED
  EXPIRED
  REPORTED // already exists in the live database; kept so the schema matches it
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  notificationsReadAt DateTime?

  accounts Account[]
  sessions Session[]

  chefProfile      ChefProfile?
  chefPhoto        ChefPhoto?
  blockedDays      ChefBlockedDay[]
  customerBookings Booking[] @relation("CustomerBookings")
  chefBookings     Booking[] @relation("ChefBookings")
  reviewsWritten   Review[]  @relation("ReviewCustomer")
  reviewsReceived  Review[]  @relation("ReviewChef")
  reports Report[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ChefProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  displayName     String
  bio             String   @db.Text
  city            String
  cuisines        String[] // stored lowercase
  pricePerPerson  Int      // INR
  maxGuests       Int      @default(10)
  yearsExperience Int      @default(0)
  photoUrl        String?
  sampleMenu      String   @default("") @db.Text // one dish per line
  verified        Boolean  @default(false)
  active          Boolean  @default(true)
  suspended       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  reports Report[]
  mealPhotos MealPhoto[]

  @@index([city, active])
}

// The chef's uploaded photo. The browser shrinks it before upload, so each row is small
// (about 100 KB). Kept in its own table so list queries never load the image bytes.
model ChefPhoto {
  id          String   @id @default(cuid())
  userId      String   @unique
  contentType String
  data        Bytes
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A whole day (in India) when a chef can't take bookings. Customers can't request that day.
model ChefBlockedDay {
  id        String   @id @default(cuid())
  userId    String
  day       String   // calendar day in IST, like "2030-11-02"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

model Booking {
  id             String        @id @default(cuid())
  customerId     String
  chefId         String        // the chef's User id
  eventDate      DateTime
  proposedEventDate DateTime?
  version        Int           @default(0)
  guests         Int
  city           String
  area           String
  address        String        @db.Text
  phone          String
  notes          String?       @db.Text
  estimatedTotal Int           // INR, calculated on the server
  status         BookingStatus @default(REQUESTED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  customer User    @relation("CustomerBookings", fields: [customerId], references: [id])
  chef     User    @relation("ChefBookings", fields: [chefId], references: [id])
  review   Review?
  events   BookingEvent[]
  reports Report[]

  @@index([customerId])
  @@index([chefId, status])
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  chefId     String
  customerId String
  rating     Int      // 1-5, validated with Zod
  comment    String?  @db.Text
  createdAt  DateTime @default(now())

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  chef     User    @relation("ReviewChef", fields: [chefId], references: [id])
  customer User    @relation("ReviewCustomer", fields: [customerId], references: [id])

  @@index([chefId])
}

model BookingEvent {
  id         String         @id @default(cuid())
  bookingId  String
  actorId    String?
  kind       String?
  fromStatus BookingStatus?
  toStatus   BookingStatus
  createdAt  DateTime       @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
}

model Report {
  id String @id @default(cuid())
  reporterId String
  bookingId String?
  chefProfileId String?
  reason String
  details String @db.Text
  status String @default("OPEN")
  resolutionNote String? @db.Text
  resolvedById String?
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  reporter User @relation(fields: [reporterId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])
  chefProfile ChefProfile? @relation(fields: [chefProfileId], references: [id])
  @@unique([reporterId, bookingId])
  @@unique([reporterId, chefProfileId])
  @@index([status, createdAt])
  @@index([reporterId, reason, createdAt])
}

model AdminAction {
  id String @id @default(cuid())
  actorId String
  targetId String
  action String
  note String @db.Text
  createdAt DateTime @default(now())
  @@index([createdAt])
}

// Meal images are separate from the chef portrait and selected without bytes on pages.
model MealPhoto {
  id String @id @default(cuid())
  chefId String
  contentType String
  data Bytes
  dishName String @default("")
  caption String @default("")
  position Int
  createdAt DateTime @default(now())
  chef ChefProfile @relation(fields: [chefId], references: [id], onDelete: Cascade)
  @@index([chefId, position, createdAt])
}
