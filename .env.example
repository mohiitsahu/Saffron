# --- Database (PostgreSQL; Neon, Supabase, or a local Postgres all work) ---------------------
# The connection the app uses at runtime. With Neon, use the "pooled" connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# The direct (non-pooled) connection. Prisma uses it for migrations. Without a pooler, it can
# be the same value as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Sign-in with Google ---------------------------------------------------------------------
# Create these at https://console.cloud.google.com -> APIs & Services -> Credentials ->
# OAuth client ID (Web application). Add this redirect URI to it:
#   http://localhost:3000/api/auth/callback/google          (development)
#   https://YOUR-DOMAIN/api/auth/callback/google            (production)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- NextAuth --------------------------------------------------------------------------------
# A long random string that signs login cookies. REQUIRED in production.
# Generate one with:  openssl rand -base64 32
# (on Windows PowerShell:  [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 })) )
NEXTAUTH_SECRET=""
# The public address of the site, with no trailing slash.
NEXTAUTH_URL="http://localhost:3000"

# --- Email notifications (optional) ----------------------------------------------------------
# Saffron emails a chef when a request arrives, and a customer when it is answered. Without a key
# the app works normally and just skips the emails. Get a key at https://resend.com
RESEND_API_KEY=""
# Who the emails come from. Until you verify your own domain in Resend, leave this empty:
# the default "onboarding@resend.dev" can only deliver to the email address of your Resend account.
EMAIL_FROM=""
